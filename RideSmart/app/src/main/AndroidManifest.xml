<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ridesmart">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:name=".RideSmartApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RideSmart">
        <!-- google-services.json should be placed in app/ directory before building with Firebase services -->
        <activity
            android:name="com.ridesmart.ui.CrashDetectedActivity"
            android:exported="false"
            android:theme="@style/Theme.RideSmart.Crash">
            <intent-filter>
                <action android:name="com.ridesmart.ACTION_CRASH_DETECTED" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.ridesmart.ui.MainActivity"
            android:exported="false" />
        <activity
            android:name="com.ridesmart.ui.AuthActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.ridesmart.service.CrashDetectionService"
            android:exported="false"
            android:foregroundServiceType="location|sensors" />

        <service
            android:name="com.ridesmart.service.SyncService"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.ridesmart.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
